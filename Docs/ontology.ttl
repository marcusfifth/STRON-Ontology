                                                 :hasDate "2025-03-01T00:00:00"^^xsd:dateTime .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Atraccio
                :Ciutat
                :Esdeveniment
                :Hotel
                :PriceCategory
                :Restaurant
                :Transport
              )
] .


