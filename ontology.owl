    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#PriceCategory -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#PriceCategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#HighPrice"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#LowPrice"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#MediumPrice"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Price category enum for restaurants, hotels and transport</rdfs:comment>
        <rdfs:label>Price Category</rdfs:label>
    </owl:Class>
    


