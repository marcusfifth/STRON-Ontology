    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Autobus_Barcelona -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Autobus_Barcelona">
        <rdf:type rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#PublicTransport"/>
        <servesCity rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Barcelona"/>
        <hasCompany>Metro Barcelona</hasCompany>
        <hasPriceTransport rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.75</hasPriceTransport>
        <hasTransportName>Autobus Barcelona</hasTransportName>
        <rdfs:comment xml:lang="en">A public transport service operating in Barcelona.</rdfs:comment>
        <rdfs:label>Autobús Barcelona</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Barcelona -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Barcelona">
        <owl:sameAs rdf:resource="https://dbpedia.org/page/Barcelona"/>
        <hasCiutatName>Barcelona</hasCiutatName>
        <wgs84_pos:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">41.3874</wgs84_pos:lat>
        <wgs84_pos:long rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.1682</wgs84_pos:long>
        <rdfs:comment xml:lang="en">City instance representing Barcelona.</rdfs:comment>
        <rdfs:label>Barcelona</rdfs:label>
