        <rdfs:comment xml:lang="en">Represents a gastronomic event in a city.</rdfs:comment>
        <rdfs:label xml:lang="en">Gastronomic Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Hotel -->


