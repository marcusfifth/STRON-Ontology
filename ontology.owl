        <rdfs:label xml:lang="en">Beach Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#BudgetHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#BudgetHotel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Hotel"/>
        <rdfs:comment xml:lang="en">Represents a budget hotel providing lodging services for tourists.</rdfs:comment>
        <rdfs:label xml:lang="en">Budget Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#BusinessHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#BusinessHotel">
