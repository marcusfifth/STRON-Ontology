        <rdfs:comment xml:lang="en">The overall rating of the place</rdfs:comment>
        <rdfs:label xml:lang="en">rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRatingAtraccio -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRatingAtraccio">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRating"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Atraccio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The overall rating of the atraction</rdfs:comment>
        <rdfs:label>Rating Atraccio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRatingRestaurant -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRatingRestaurant">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRating"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The overall rating of the restuarant</rdfs:comment>
        <rdfs:label>Restaurant Rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRestaurantName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRestaurantName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name"/>
