    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#AndalusianRestaurant -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#AndalusianRestaurant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Restaurant"/>
        <rdfs:comment xml:lang="en">Represents a dining establishment offering andalusian culinary experiences.</rdfs:comment>
        <rdfs:label xml:lang="en">Andalusian Restaurant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Atraccio -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Atraccio">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasRatingAtraccio"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Represents a tourist attraction such as museums or monuments.</rdfs:comment>
        <rdfs:label xml:lang="ca">Atraccio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#BeachHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#BeachHotel">
