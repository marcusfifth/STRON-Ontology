    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Transport -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Transport">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasCompany"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Represents a mode of transport available in the city.</rdfs:comment>
        <rdfs:label xml:lang="ca">Transport</rdfs:label>
    </owl:Class>
    


