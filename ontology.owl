                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Represents a dining establishment offering culinary experiences.</rdfs:comment>
        <rdfs:label xml:lang="ca">Restaurant</rdfs:label>
    </owl:Class>
    


