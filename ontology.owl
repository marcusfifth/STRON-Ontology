    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Esdeveniment -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Esdeveniment">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasDate"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Represents a tourism event, such as a conference or festival.</rdfs:comment>
        <rdfs:label xml:lang="ca">Esdeveniment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#GastroEvent -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#GastroEvent">
