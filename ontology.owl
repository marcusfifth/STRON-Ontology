    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat">
