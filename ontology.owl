    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#CulturalEvent -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#CulturalEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Esdeveniment"/>
        <rdfs:comment xml:lang="en">Represents a cultural event in a city.</rdfs:comment>
