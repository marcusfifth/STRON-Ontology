        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">An estimated/average of what the hotel will cost</rdfs:comment>
        <rdfs:label xml:lang="en">Hotel Price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceRestaurant -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceRestaurant">
