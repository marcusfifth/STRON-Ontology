    </owl:Class>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#CulturalAtraccio -->


    <owl:Class rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#CulturalAtraccio">
