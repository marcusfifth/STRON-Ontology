        <rdfs:comment xml:lang="en">The name of the restaurant</rdfs:comment>
        <rdfs:label xml:lang="en">Restaurang name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasTransportName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasTransportName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the transport</rdfs:comment>
        <rdfs:label xml:lang="en">Transport name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isUpcoming -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isUpcoming">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Esdeveniment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">true if event is in the future, false otherwhise.</rdfs:comment>
        <rdfs:label xml:lang="en">is upcoming</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the place/activity</rdfs:comment>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#tourismActivityScore -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#tourismActivityScore">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A numeric indicator reflecting the overall tourism activity within the city.</rdfs:comment>
        <rdfs:label xml:lang="en">tourism activity score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#lat -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#lat">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The geographical latitude coordinates of the city.</rdfs:comment>
        <rdfs:label xml:lang="en">Latitude Coordinates</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#long -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#long">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The geographical longitude coordinates of the city.</rdfs:comment>
        <rdfs:label xml:lang="en">Longitude Coordinates</rdfs:label>
    </owl:DatatypeProperty>
    


