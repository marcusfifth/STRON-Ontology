    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasAtraccioName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasAtraccioName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Atraccio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the atraction</rdfs:comment>
        <rdfs:label xml:lang="en">Atraction name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasCiutatName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasCiutatName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the city</rdfs:comment>
        <rdfs:label xml:lang="en">City name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasCompany -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasCompany">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The company providing the transport service.</rdfs:comment>
        <rdfs:label xml:lang="en">company</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Esdeveniment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date when the event takes place.</rdfs:comment>
        <rdfs:label xml:lang="en">event date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasEsdevenimentName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasEsdevenimentName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Esdeveniment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the event</rdfs:comment>
        <rdfs:label xml:lang="en">Event name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasHotelCategory -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasHotelCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">category of the hotel. ranging from 1 to 5. Also known as stars.</rdfs:comment>
        <rdfs:label xml:lang="en">hotel cateogry</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasHotelName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasHotelName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#name"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name of the hotel</rdfs:comment>
        <rdfs:label xml:lang="en">Hotel name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPrice -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPrice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">An estimated/average of what the activity will cost</rdfs:comment>
        <rdfs:label xml:lang="en">price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceHotel -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceHotel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPrice"/>
