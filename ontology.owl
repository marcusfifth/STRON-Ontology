<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#"
     xml:base="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:STRON="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON">
        <terms:abstract xml:lang="en">STRON is a Smart Tourism Recommendations Ontology designed to integrate data on events, hotels, restaurants, attractions, and transport within urban environments. It supports complex queries and inference via OWL restrictions and SWRL rules, enabling recommendations based on quality, affordability, temporal scheduling, and geographical proximity. STRON aims to facilitate data interoperability and enrich decision support in tourism applications</terms:abstract>
        <terms:title xml:lang="en">STRON: Smart Tourism Recommendations Ontology</terms:title>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceCategoryHotel -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceCategoryHotel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Hotel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#PriceCategory"/>
        <rdfs:comment xml:lang="en">Relates a hotel to a price category such as low, medium or high.</rdfs:comment>
        <rdfs:label xml:lang="en">has hotel price category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceCategoryRestaurant -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceCategoryRestaurant">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Restaurant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#PriceCategory"/>
        <rdfs:comment xml:lang="en">Relates a restaurant to a price category such as low, medium or high.</rdfs:comment>
        <rdfs:label xml:lang="en">has restaurant price category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceCategoryTransport -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#hasPriceCategoryTransport">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Transport"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#PriceCategory"/>
        <rdfs:comment xml:lang="en">Relates a transport to a price category such as low, medium or high.</rdfs:comment>
        <rdfs:label xml:lang="en">has transport price category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isLocatedInAtraccio -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isLocatedInAtraccio">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Atraccio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:comment xml:lang="en">Relates an attraction to its city.</rdfs:comment>
        <rdfs:label xml:lang="en">is located in (atractions)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isLocatedInHotel -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isLocatedInHotel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Hotel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:comment xml:lang="en">Relates a hotel to its city.</rdfs:comment>
        <rdfs:label xml:lang="en">is located in (hotels)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isLocatedInRestaurant -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#isLocatedInRestaurant">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Restaurant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:comment xml:lang="en">Relates a restauran to its city.</rdfs:comment>
        <rdfs:label xml:lang="en">is located in (restaurants)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#occursIn -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#occursIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Esdeveniment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:comment xml:lang="en">Relates an event to the city where it occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">occurs in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#servesCity -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#servesCity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Transport"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/marcusfifth/ontologies/2025/3/STRON#Ciutat"/>
        <rdfs:comment xml:lang="en">Relates a transport service to the city it serves.</rdfs:comment>
        <rdfs:label xml:lang="en">serves city</rdfs:label>
    </owl:ObjectProperty>
    


